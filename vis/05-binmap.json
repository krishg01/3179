{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "rgba(247, 243, 234, 0.72)",
  "width": "container",
  "height": 450,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2E8D6",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/monotremes_binned.csv"
      },
      "mark": {
        "type": "square",
        "size": 40,
        "opacity": 0.85,
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "scheme": "goldgreen",
            "type": "log"
          },
          "title": "Sighting Count"
        }
      }
    },
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#ffffff",
        "strokeWidth": 0.7,
        "strokeJoin": "round"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    
    {
      "data": {
        "values": [
          {
            "lon_start": 146, "lat_start": -35,
            "lon_end": 160, "lat_end": -35,
            "align": "left",
            "baseline": "middle",
            "show_line": false,
            "text": [
              "Most sightings are in the south-east,",
              "where most Australians live and where",
              "rivers suit platypus. More observers",
              "= more records."
            ]
          },
          {
            "lon_start": 122, "lat_start": -25,
            "lon_end": 110, "lat_end": -15,
            "align": "right",
            "baseline": "middle",
            "show_line": false,
            "text": [
              "Blank space does not mean absent.",
              "Few people live here, and short-beaked",
              "echidnas range across almost the",
              "whole continent."
            ]
          }
        ]
      },
      "layer": [
        {
           "transform": [
          { "filter": "datum.show_line == true" }
          ],
          "mark": {
            "type": "rule",
            "color": "#A34A2A",
            "strokeWidth": 1.5,
            "strokeDash": [3, 3]
          },
          "encoding": {
            "longitude": {"field": "lon_start", "type": "quantitative"},
            "latitude": {"field": "lat_start", "type": "quantitative"},
            "longitude2": {"field": "lon_end", "type": "quantitative"},
            "latitude2": {"field": "lat_end", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 8,
            "dy": 0,
            "fontSize": 11,
            "fontStyle": "italic",
            "fill": "#1A2620"
          },
          "encoding": {
            "longitude": {"field": "lon_end", "type": "quantitative"},
            "latitude": {"field": "lat_end", "type": "quantitative"},
            "text": {"field": "text", "type": "nominal"},
            "align": {"field": "align"},
            "baseline": {"field": "baseline"}
          }
        }
      ]
    }
  ]
}