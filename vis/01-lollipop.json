{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "rgba(247, 243, 234, 0.72)",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      {"Country": "Indonesia", "Species": 801},
      {"Country": "Brazil", "Species": 789},
      {"Country": "China", "Species": 756},
      {"Country": "Mexico", "Species": 587},
      {"Country": "Peru", "Species": 585},
      {"Country": "Australia", "Species": 362}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3.5
      },
      "encoding": {
        "x": {
          "field": "Species",
          "type": "quantitative"
        },
        "x2": {
          "datum": 0
        },
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x"
        },
        "color": {
          "condition": {
            "test": "datum.Country === 'Australia'",
            "value": "#d62728"
          },
          "value": "#b8c6d1"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 200
      },
      "encoding": {
        "x": {
          "field": "Species",
          "type": "quantitative",
          "title": "Living mammal species",
          "scale": {
            "domain": [0, 850]
          }
        },
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "color": {
          "condition": {
            "test": "datum.Country === 'Australia'",
            "value": "#d62728"
          },
          "value": "#4c78a8"
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Species",
            "type": "quantitative",
            "title": "Living species"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Country === 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#d62728"
      },
      "encoding": {
        "x": {
          "field": "Species",
          "type": "quantitative"
        },
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x"
        },
        "text": {
          "field": "Species"
        },
        "size": {
          "value": 12
        }
      }
    }
  ],
  "config": {
    "axis": {
      "grid": true,
      "gridOpacity": 0.3
    },
    "view": {
      "stroke": null
    }
  }
}