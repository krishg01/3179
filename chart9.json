{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "background": "#f7f6f0",
  "width": 420,
  "height": 320,
  "autosize": "pad",
  "signals": [{"name": "nodeW", "value": 14}],

  "data": [
    {
      "name": "table",
      "url": "MamFuncDat.txt",
      "format": {"type": "tsv", "parse": "auto"},
      "transform": [
        {
          "type": "formula", "as": "Mammal_Group",
          "expr": "indexof(['Macropodidae','Phascolarctidae','Vombatidae','Petauridae','Pseudocheiridae','Burramyidae','Acrobatidae','Tarsipedidae'], datum.MSWFamilyLatin) >= 0 ? 'Diprotodontia' : indexof(['Dasyuridae','Myrmecobiidae'], datum.MSWFamilyLatin) >= 0 ? 'Dasyuromorphia' : indexof(['Peramelidae','Thylacomyidae'], datum.MSWFamilyLatin) >= 0 ? 'Peramelemorphia' : indexof(['Tachyglossidae','Ornithorhynchidae'], datum.MSWFamilyLatin) >= 0 ? 'Monotremata' : datum.MSWFamilyLatin == 'Muridae' ? 'Native Rodents' : indexof(['Pteropodidae','Vespertilionidae'], datum.MSWFamilyLatin) >= 0 ? 'Bats' : 'Other'"
        },
        {"type": "filter", "expr": "datum.Mammal_Group != 'Other'"},
        {
          "type": "formula", "as": "Primary_Diet",
          "expr": "datum['Diet-Inv'] >= 50 ? 'Insectivore / Invertebrates' : (datum['Diet-PlantO'] + datum['Diet-Seed'] >= 50) ? 'Herbivore' : datum['Diet-Fruit'] >= 50 ? 'Frugivore' : datum['Diet-Nect'] >= 50 ? 'Nectarivore' : (datum['Diet-Vend'] + datum['Diet-Vect'] + datum['Diet-Vfish'] >= 50) ? 'Carnivore' : 'Omnivore'"
        },
        {"type": "aggregate", "groupby": ["Mammal_Group", "Primary_Diet"]},
        {
          "type": "stack", "field": "count",
          "sort": {"field": ["Primary_Diet", "Mammal_Group"]},
          "as": ["sy0", "sy1"]
        },
        {
          "type": "stack", "field": "count",
          "sort": {"field": ["Mammal_Group", "Primary_Diet"]},
          "as": ["ty0", "ty1"]
        }
      ]
    },
    {
      "name": "left",
      "source": "table",
      "transform": [
        {"type": "aggregate", "groupby": ["Primary_Diet"], "ops": ["sum"], "fields": ["count"], "as": ["count"]},
        {"type": "stack", "field": "count", "sort": {"field": "Primary_Diet"}, "as": ["y0", "y1"]}
      ]
    },
    {
      "name": "right",
      "source": "table",
      "transform": [
        {"type": "aggregate", "groupby": ["Mammal_Group"], "ops": ["sum"], "fields": ["count"], "as": ["count"]},
        {"type": "stack", "field": "count", "sort": {"field": "Mammal_Group"}, "as": ["y0", "y1"]}
      ]
    }
  ],

  "scales": [
    {"name": "y", "type": "linear", "zero": true, "domain": {"data": "left", "field": "y1"}, "range": [0, {"signal": "height"}]},
    {
      "name": "color", "type": "ordinal",
      "domain": {"data": "table", "field": "Primary_Diet", "sort": true},
      "range": {"scheme": "set2"}
    }
  ],

  "marks": [
    {
      "type": "path",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "path": {"signal": "'M' + nodeW + ',' + scale('y', (datum.sy0 + datum.sy1)/2) + ' C' + (width/2) + ',' + scale('y', (datum.sy0 + datum.sy1)/2) + ' ' + (width/2) + ',' + scale('y', (datum.ty0 + datum.ty1)/2) + ' ' + (width - nodeW) + ',' + scale('y', (datum.ty0 + datum.ty1)/2)"},
          "stroke": {"scale": "color", "field": "Primary_Diet"},
          "strokeWidth": {"signal": "scale('y', datum.count) - scale('y', 0)"},
          "strokeOpacity": {"value": 0.5},
          "fill": {"value": null},
          "tooltip": {"signal": "{'Group': datum.Mammal_Group, 'Diet Niche': datum.Primary_Diet, 'Species Count': datum.count}"}
        },
        "hover": {"strokeOpacity": {"value": 0.9}}
      }
    },
    {
      "type": "rect",
      "from": {"data": "left"},
      "encode": {
        "update": {
          "x": {"value": 0}, "width": {"signal": "nodeW"},
          "y": {"scale": "y", "field": "y0"}, "y2": {"scale": "y", "field": "y1"},
          "fill": {"scale": "color", "field": "Primary_Diet"}, "stroke": {"value": "#f7f6f0"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "right"},
      "encode": {
        "update": {
          "x": {"signal": "width - nodeW"}, "width": {"signal": "nodeW"},
          "y": {"scale": "y", "field": "y0"}, "y2": {"scale": "y", "field": "y1"},
          "fill": {"value": "#444"}, "stroke": {"value": "#f7f6f0"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "left"},
      "encode": {
        "update": {
          "x": {"value": -8}, "align": {"value": "right"}, "baseline": {"value": "middle"},
          "y": {"signal": "scale('y', (datum.y0 + datum.y1)/2)"},
          "text": {"signal": "datum.Primary_Diet + ' (' + datum.count + ')'"},
          "fontSize": {"value": 12}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "right"},
      "encode": {
        "update": {
          "x": {"signal": "width + 8"}, "align": {"value": "left"}, "baseline": {"value": "middle"},
          "y": {"signal": "scale('y', (datum.y0 + datum.y1)/2)"},
          "text": {"signal": "datum.Mammal_Group + ' (' + datum.count + ')'"},
          "fontSize": {"value": 12}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 0}, "y": {"value": -8}, "align": {"value": "left"},
          "text": {"value": "Diet Niche"}, "fontWeight": {"value": "bold"}, "fontSize": {"value": 13}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "width"}, "y": {"value": -8}, "align": {"value": "right"},
          "text": {"value": "Australian Mammal Group"}, "fontWeight": {"value": "bold"}, "fontSize": {"value": 13}
        }
      }
    }
  ]
}