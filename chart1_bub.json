{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Living Australian Mammal Species by Order",
    "fontSize": 15,
    "font": "Space Grotesk",
    "anchor": "start"
  },
  "width": "container",
  "height": 260,
  "data": {
    "values": [
      {"Group": "Marsupial", "Species": 169},
      {"Group": "Placental", "Species": 191},
      {"Group": "Monotreme", "Species": 2}
    ]
  },
  "mark": {"type": "circle", "opacity": 0.8},
  "encoding": {
    "x": {
      "field": "Group",
      "type": "nominal",
      "axis": {"labelAngle": 0, "title": "Mammal Group"}
    },
    "y": {
      "field": "Species",
      "type": "quantitative",
      "axis": {"title": "Number of Species"}
    },
    "size": {
      "field": "Species",
      "type": "quantitative",
      "scale": {"range": [100, 2000]},
      "legend": {"title": "Species Count"}
    },
    "color": {
      "field": "Group",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {"field": "Group", "type": "nominal"},
      {"field": "Order", "type": "nominal", "title": "Order Notes"},
      {"field": "Species", "type": "quantitative", "title": "Total Species"}
    ]
  }
}